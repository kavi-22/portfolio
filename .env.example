# =========================================================================
# Next.js Portfolio Environment Variables
# =========================================================================

# Resend API Key for sending contact form messages
# Obtain your free API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient Email address where portfolio contact inquiries should be delivered
CONTACT_EMAIL=your_email@domain.com

# Sender email configured in Resend (e.g., onboarding@resend.dev for testing, or your verified domain)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Resume URL (Google Drive, Cloud storage, or /resume.pdf)
RESUME_LINK=https://drive.google.com/file/d/your_drive_file_id/view?usp=sharing
NEXT_PUBLIC_RESUME_LINK=https://drive.google.com/file/d/your_drive_file_id/view?usp=sharing
